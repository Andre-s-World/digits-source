        },
        {
          "sdk": "SystemExtensions.framework"
        },
        {
          "sdk": "Security.framework"
        }
      ],
      "postBuildScripts": [
        {
          "name": "Embed frozen Digits Touch and one-shot maintenance tool",
          "script": "set -eu\nmkdir -p \"$TARGET_BUILD_DIR/$CONTENTS_FOLDER_PATH/Library/SystemExtensions\" \"$TARGET_BUILD_DIR/$CONTENTS_FOLDER_PATH/Library/Helpers\"\n/usr/bin/ditto \"$SRCROOT/DigitsDriver/Packaging/TouchDevelopment/Digits.app/Contents/Library/SystemExtensions/local.digits.touch.dext\" \"$TARGET_BUILD_DIR/$CONTENTS_FOLDER_PATH/Library/SystemExtensions/local.digits.touch.dext\"\n/bin/cp \"$BUILT_PRODUCTS_DIR/digits-maintenance\" \"$TARGET_BUILD_DIR/$CONTENTS_FOLDER_PATH/Library/Helpers/digits-maintenance\"\nif [ \"$CODE_SIGNING_ALLOWED\" = YES ]; then /usr/bin/codesign --force --sign \"$EXPANDED_CODE_SIGN_IDENTITY\" --options runtime \"$TARGET_BUILD_DIR/$CONTENTS_FOLDER_PATH/Library/Helpers/digits-maintenance\"; fi\n# Embed scripts also run during incremental builds. Seal the outer bundle after\n# the helper changes so an unchanged app executable cannot leave a stale seal.\nif [ \"$CODE_SIGNING_ALLOWED\" = YES ]; then\n    if [ -n \"${CODE_SIGN_ENTITLEMENTS:-}\" ]; then\n        /usr/bin/codesign --force --sign \"$EXPANDED_CODE_SIGN_IDENTITY\" --options runtime --entitlements \"$SRCROOT/$CODE_SIGN_ENTITLEMENTS\" \"$TARGET_BUILD_DIR/$WRAPPER_NAME\"\n    else\n        /usr/bin/codesign --force --sign \"$EXPANDED_CODE_SIGN_IDENTITY\" --options runtime \"$TARGET_BUILD_DIR/$WRAPPER_NAME\"\n    fi\nfi\n",
          "basedOnDependencyAnalysis": false
        }
      ]
    },
