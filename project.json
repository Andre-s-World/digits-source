          "script": "set -eu\npayloads=\"$SRCROOT/.build/InstallerPayloads\"\ntest -f \"$payloads/PayloadManifest.json\"\nmkdir -p \"$TARGET_BUILD_DIR/$CONTENTS_FOLDER_PATH/Library/Helpers\" \"$TARGET_BUILD_DIR/$UNLOCALIZED_RESOURCES_FOLDER_PATH/Payloads\"\n/usr/bin/ditto \"$payloads\" \"$TARGET_BUILD_DIR/$UNLOCALIZED_RESOURCES_FOLDER_PATH/Payloads\"\n/bin/cp \"$BUILT_PRODUCTS_DIR/digits-installer-maintenance\" \"$TARGET_BUILD_DIR/$CONTENTS_FOLDER_PATH/Library/Helpers/digits-installer-maintenance\"\nif [ \"$CODE_SIGNING_ALLOWED\" = YES ]; then /usr/bin/codesign --force --sign \"$EXPANDED_CODE_SIGN_IDENTITY\" --options runtime \"$TARGET_BUILD_DIR/$CONTENTS_FOLDER_PATH/Library/Helpers/digits-installer-maintenance\"; fi\n# Embed scripts also run during incremental builds. Seal the outer bundle after\n# the helper changes so an unchanged app executable cannot leave a stale seal.\nif [ \"$CODE_SIGNING_ALLOWED\" = YES ]; then\n    if [ -n \"${CODE_SIGN_ENTITLEMENTS:-}\" ]; then\n        /usr/bin/codesign --force --sign \"$EXPANDED_CODE_SIGN_IDENTITY\" --options runtime --entitlements \"$SRCROOT/$CODE_SIGN_ENTITLEMENTS\" \"$TARGET_BUILD_DIR/$WRAPPER_NAME\"\n    else\n        /usr/bin/codesign --force --sign \"$EXPANDED_CODE_SIGN_IDENTITY\" --options runtime \"$TARGET_BUILD_DIR/$WRAPPER_NAME\"\n    fi\nfi\n"
        }
      ]
    }
