      "postBuildScripts": [
        {
          "name": "Embed Digits Touch DriverKit extension",
          "script": "set -eu\nmkdir -p \"$TARGET_BUILD_DIR/$CONTENTS_FOLDER_PATH/Library/SystemExtensions\"\n/usr/bin/ditto \"$BUILD_DIR/$CONFIGURATION-driverkit/local.digits.touch.dext\" \"$TARGET_BUILD_DIR/$CONTENTS_FOLDER_PATH/Library/SystemExtensions/local.digits.touch.dext\"\n# Remove a stale daemon definition from incremental builds before code signing.\nrm -f \"$TARGET_BUILD_DIR/$CONTENTS_FOLDER_PATH/Library/LaunchDaemons/local.digits.touch.association.plist\"\n",
          "basedOnDependencyAnalysis": false
        }
      ]
