<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.digits.touch.association</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Digits.app/Contents/MacOS/Digits</string>
		<string>--associate-system</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>UserName</key>
	<string>root</string>
	<key>StandardOutPath</key>
	<string>/Library/Logs/Digits/Touch.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/Digits/Touch.log</string>
</dict>
</plist>
